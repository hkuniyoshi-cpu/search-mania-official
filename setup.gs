/* ============================================================
   既存スプレッドシートにタブを構築する
   ============================================================ */
function setupExistingSpreadsheet() {
  const ss = SpreadsheetApp.openById(EXISTING_SS_ID);
  Logger.log('=========================================');
  Logger.log('✅ 既存スプレッドシートを開きました');
  Logger.log('名前: ' + ss.getName());
  Logger.log('URL: ' + ss.getUrl());
  Logger.log('=========================================');
  _populateAllSheets_(ss);
  Logger.log('✅ 全シート構築完了');
  Logger.log('次のステップ: Code.gs の SS_ID は既に設定済み。GAS をデプロイしてください。');
}

/* ============================================================
   新規スプレッドシートを作る（既存IDを使わない場合のみ）
   ============================================================ */
function createCMSSpreadsheet() {
  const ss = SpreadsheetApp.create('【SearchMania HP CMS】');
  const id = ss.getId();
  Logger.log('=========================================');
  Logger.log('✅ Spreadsheet 作成完了');
  Logger.log('Spreadsheet ID: ' + id);
  Logger.log('URL: ' + ss.getUrl());
  Logger.log('=========================================');
  _populateAllSheets_(ss);
  Logger.log('✅ 全シート作成完了');
  Logger.log('次のステップ: Code.gs の SS_ID にこのIDを貼り付け → デプロイ');
}

